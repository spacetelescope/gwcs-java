#ASDF 1.0.0
#ASDF_STANDARD 1.6.0
%YAML 1.1
%TAG ! tag:stsci.edu:asdf/
--- !core/asdf-1.1.0
asdf_library: !core/software-1.0.0 {author: The ASDF Developers, homepage: 'http://github.com/asdf-format/asdf',
  name: asdf, version: 5.3.1}
history:
  extensions:
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/core/extensions/core-1.6.0
    manifest_software: !core/software-1.0.0 {name: asdf_standard, version: 1.3.0}
    software: !core/software-1.0.0 {name: asdf, version: 5.3.1}
roman:
  roman:
    meta:
      wcs: !<tag:stsci.edu:gwcs/wcs-1.4.0>
        name: 045p86x47y51
        pixel_shape: [5000, 5000]
        steps:
        - !<tag:stsci.edu:gwcs/step-1.3.0>
          frame: !<tag:stsci.edu:gwcs/frame2d-1.2.0>
            axes_names: [x, y]
            axes_order: [0, 1]
            axis_physical_types: ['custom:x', 'custom:y']
            name: detector
            unit: [!unit/unit-1.0.0 pixel, !unit/unit-1.0.0 pixel]
          transform: !<tag:stsci.edu:gwcs/fitswcs_imaging-1.0.0>
            bounding_box: !transform/property/bounding_box-1.1.0
              ignore: []
              intervals:
                x: [-0.5, 4999.5]
                y: [-0.5, 4999.5]
              order: F
            cdelt: !core/ndarray-1.1.0
              source: 155
              datatype: float64
              byteorder: little
              shape: [2]
            crpix: !core/ndarray-1.1.0
              source: 153
              datatype: float64
              byteorder: little
              shape: [2]
            crval: !core/ndarray-1.1.0
              source: 154
              datatype: float64
              byteorder: little
              shape: [2]
            inputs: [x, y]
            outputs: [lon, lat]
            pc: !core/ndarray-1.1.0
              source: 156
              datatype: float64
              byteorder: little
              shape: [2, 2]
            projection: !transform/gnomonic-1.3.0
              direction: pix2sky
              inputs: [x, y]
              outputs: [phi, theta]
        - !<tag:stsci.edu:gwcs/step-1.3.0>
          frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
            axes_names: [lon, lat]
            axes_order: [0, 1]
            axis_physical_types: [pos.eq.ra, pos.eq.dec]
            name: icrs
            reference_frame: !<tag:astropy.org:astropy/coordinates/frames/icrs-1.1.0>
              frame_attributes: {}
            unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
          transform: null
...
